# Copy to .env for local development. Never commit .env.
# These values are local-only defaults; real environments get theirs from GitHub Environment secrets.

# PostgreSQL
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_local_password
POSTGRES_DB=orders

# RabbitMQ
RABBITMQ_DEFAULT_USER=orders
RABBITMQ_DEFAULT_PASS=orders_local_password

# Development sign-in of the BFF (http://localhost:8080/bff/login): passwords of the users shopper and admin.
# Placeholder for an identity provider (see README); only the development compose turns it on.
BFF_SHOPPER_PASSWORD=shopper_local_password
BFF_ADMIN_PASSWORD=admin_local_password

# Service-to-service tokens: the BFF signs a 5-minute JWT per user and service (HMAC-SHA256, at least 32 bytes);
# orders-api and catalog-api validate it. Placeholder for an identity provider's token exchange (see README).
SERVICE_TOKEN_SIGNING_KEY=local_service_token_signing_key_change_me_0123456789

# Load test (profile "load"): how long tests/load/orders.js runs; 10m is the peak profile of the sizing document,
# use e.g. 30s for a quick check of the script (the latency thresholds still apply).
LOAD_DURATION=10m

# Aspire Dashboard (profile "observability"), published on 127.0.0.1 only
ASPIRE_DASHBOARD_PORT=18888

# Orders API and orders-migrator receive ConnectionStrings__Orders from compose, built from the POSTGRES_* values above.
# To run Orders.Api outside compose, set it yourself, e.g.:
# ConnectionStrings__Orders=Host=localhost;Database=orders;Username=orders;Password=<POSTGRES_PASSWORD>

# Orders API receives ConnectionStrings__RabbitMq from compose, built from the RABBITMQ_* values above; keep the password
# URL-safe (it is part of an amqp:// URI). To run it outside compose: ConnectionStrings__RabbitMq=amqp://orders:<password>@localhost:5672
# Orders.Worker gets the same two connection strings. Its retry delays and the poll interval for due retries:
# Orders__Worker__RetryDelays__0=00:00:05
# Orders__Worker__RetryDelays__1=00:00:30
# Orders__Worker__RetryDelays__2=00:05:00
# Orders__Worker__ScheduledJobPollingInterval=00:00:05
# Orders__Messaging__Enabled=true       # false: no RabbitMQ routing (used by the migrator and by tests without a broker)
# Orders__Messaging__AutoProvision=true # declare the exchange and queues at startup (same objects as deploy/rabbitmq/definitions.json)

# Orders__Confirmation__CacheDuration=00:00:05 # how long each process caches the active confirmation rules; an admin write empties only the API's cache, so the Worker waits this long
# Orders__Confirmation__SeedEnabled=false # true adds the development rule "hold BRL orders above 5,000.00" when the migrator runs (compose sets it; staging and production must not)

# Retention (Orders.Worker): event log rows older than EventLogRetention and idempotency records past their 24 h expiry are deleted in batches
# Orders__Retention__EventLogRetention=30.00:00:00
# Orders__Retention__BatchSize=1000
# Orders__Retention__Interval=01:00:00

# Metrics poll (Orders.Worker): how often it reads the OnHold orders and the dead letter queue for the gauges orders.on_hold,
# orders.on_hold.oldest_age and rabbitmq.dlq.depth
# Orders__Metrics__PollInterval=00:00:30

# Orders discounts (defaults in orders/src/Orders.Api/appsettings.json; override only when needed):
# Orders__Discounts__CacheDuration=00:01:00
# Orders__Discounts__MaxDiscountPercent=50

# Orders.Bff (defaults in orders/src/Orders.Bff/appsettings.json; compose uses them as they are):
# Bff__Orders__BaseAddress=http://orders-api:8080
# Bff__Catalog__BaseAddress=http://catalog-api:8080
# Bff__MaxRequestBodySize=1048576   # bytes; larger bodies get 413 before anything is forwarded
# Bff__DevLogin__Enabled=false       # compose sets true with the two passwords above
# Orders.Bff receives ConnectionStrings__RabbitMq from compose (live Admin feed, its own exclusive queue on orders.events):
# Bff__Events__HeartbeatInterval=00:00:15
