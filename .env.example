# Copy to .env for local development. Never commit .env.
# These values are local-only defaults; real environments get theirs from GitHub Environment secrets.

# PostgreSQL
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_local_password
POSTGRES_DB=orders

# RabbitMQ
RABBITMQ_DEFAULT_USER=orders
RABBITMQ_DEFAULT_PASS=orders_local_password

# Aspire Dashboard (profile "observability"), published on 127.0.0.1 only
ASPIRE_DASHBOARD_PORT=18888

# Orders API and orders-migrator receive ConnectionStrings__Orders from compose, built from the POSTGRES_* values above.
# To run Orders.Api outside compose, set it yourself, e.g.:
# ConnectionStrings__Orders=Host=localhost;Database=orders;Username=orders;Password=<POSTGRES_PASSWORD>

# Orders API receives ConnectionStrings__RabbitMq from compose, built from the RABBITMQ_* values above; keep the password
# URL-safe (it is part of an amqp:// URI). To run it outside compose: ConnectionStrings__RabbitMq=amqp://orders:<password>@localhost:5672
# Orders.Worker gets the same two connection strings. Its retry delays and the poll interval for due retries:
# Orders__Worker__RetryDelays__0=00:00:05
# Orders__Worker__RetryDelays__1=00:00:30
# Orders__Worker__RetryDelays__2=00:05:00
# Orders__Worker__ScheduledJobPollingInterval=00:00:05
# Orders__Messaging__Enabled=true       # false: no RabbitMQ routing (used by the migrator and by tests without a broker)
# Orders__Messaging__AutoProvision=true # declare the exchange and queues at startup (same objects as deploy/rabbitmq/definitions.json)

# Orders__Confirmation__SeedEnabled=false # true adds the development rule "hold BRL orders above 5,000.00" when the migrator runs (compose sets it; staging and production must not)

# Orders discounts (defaults in orders/src/Orders.Api/appsettings.json; override only when needed):
# Orders__Discounts__CacheDuration=00:01:00
# Orders__Discounts__MaxDiscountPercent=50
